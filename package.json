{
  "name": "repo-fixture-refresh-skill",
  "version": "0.1.0",
  "description": "Plans stale fixture refreshes from latest local command logs without unsafe rewrites.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "repo-fixture-refresh": "dist/cli.js"
  },
  "files": [
    "dist",
    "scripts/clean-build.js",
    "LICENSE",
    "README.md",
    "SKILL.md",
    "docs",
    "fixtures",
    "scripts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node scripts/clean-build.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node scripts/clean-build.js .test-dist && tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js",
    "smoke": "npm run build && bash scripts/smoke.sh",
    "package:smoke": "npm run build && bash scripts/package-smoke.sh"
  },
  "keywords": [
    "agent-skill",
    "dry-run",
    "local-first",
    "automation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/repo-fixture-refresh-skill.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/repo-fixture-refresh-skill/issues"
  },
  "homepage": "https://github.com/rogerchappel/repo-fixture-refresh-skill#readme",
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2"
  }
}
